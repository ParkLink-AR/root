# Variables compartidas para levantar todo el ecosistema con `docker compose up`
# en la raíz. Cada servicio también tiene su propio .env.example con más detalle
# si preferís levantarlo suelto.

ENVIRONMENT=development

# --- auth-service / gateway (deben coincidir entre sí) ---
JWT_SECRET=dev-secret-change-me
# Para JWT asimétrico (RS256): JWT_PRIVATE_KEY en auth-service y JWT_PUBLIC_KEY en gateway
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Autenticación interna Gateway -> Microservicios ---
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-change-me

# --- booking-service / payment-service (deben coincidir entre sí) ---
# Protege POST /internal/refund-by-payment, que booking-service llama
# directo (no pasa por el gateway) cuando el dueño rechaza -- o nunca
# responde a -- una reserva que requiere su aprobación.
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# Sin BREVO_API_KEY, auth-service no manda emails de verdad: en cambio, loguea
# el código de verificación de 6 dígitos ("[MAIL][DEV] Código de verificación
# para ...") -- mirá `docker compose logs -f auth-service` para copiarlo.
# SKIP_EMAIL_VERIFICATION=true saltea el requisito de confirmar el mail para
# loguear (útil para tests automatizados); en local, dejalo en false para
# probar el flujo real de código de 6 dígitos que ve mobile.
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# Twilio (SMS) - https://console.twilio.com. Mismo criterio que Brevo: sin
# credenciales, loguea el código en vez de mandar un SMS real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SKIP_EMAIL_VERIFICATION=true
SKIP_PHONE_VERIFICATION=true

# --- parking-service ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=parklink-app/1.0

# --- Cloudflare R2 (auth-service + parking-service, mismo bucket) ---
# Avatares de usuario y fotos de cochera. Creá una cuenta en
# https://dash.cloudflare.com -> R2 -> Create bucket, habilitá "Public
# access" (te da la URL r2.dev para R2_PUBLIC_URL) y creá un API token
# (R2 > Manage API Tokens) con permisos sobre ese bucket para el
# access key/secret. Sin esto, subir fotos falla.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Cloudflare R2 (booking-service, bucket PRIVADO y separado) ---
# Comprobantes de transferencia (payout proofs) -- documentos financieros
# privados, nunca deben vivir en el mismo bucket público que las fotos de
# cochera/perfil. Creá un SEGUNDO bucket en el mismo dashboard de R2 (p. ej.
# "parklink-payout-proofs"), NO le actives "Public access" ni le conectes un
# dominio público -- booking-service genera URLs firmadas de corta duración
# para leerlos, nunca una URL pública fija. El token de R2_ACCESS_KEY_ID de
# arriba necesita permiso sobre este bucket también (editalo en R2 > Manage
# API Tokens si hace falta).
R2_PAYOUT_PROOFS_BUCKET_NAME=

# --- payment-service ---
# Credenciales de prueba (TEST) de Mercado Pago Developers. Sin esto el
# servicio arranca igual, pero crear una preferencia de pago real falla.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_SECRET_DE_MERCADO_PAGO
MP_FORCE_TEST_PAYER_EMAIL=
APP_BASE_URL=http://localhost:8004
WEBHOOK_BASE_URL=http://localhost:8004
# El deep link de vuelta a la app (parklink://payment/pending) ya no se
# configura acá -- payment-service lo arma solo en su endpoint
# GET /payment-return, que es a donde apuntan los back_urls de Mercado Pago.
DEFAULT_CURRENCY=ARS
# admin-dashboard le pega directo a payment-service (no vía gateway) para
# /api/payments/metrics -- CORS propio, separado del de gateway.
PAYMENT_CORS_ORIGINS=*

# --- notifications-service ---
# Manda las push por Firebase Cloud Messaging. Dejá el JSON de service account
# de Firebase (Console -> Configuración del proyecto -> Cuentas de servicio ->
# Generar nueva clave privada) en ./notifications-service/secrets/ y descomentá
# la línea de abajo apuntando al path DENTRO del contenedor. Vacío / sin setear
# = modo log-only: consume el evento y loguea la notificación, sin llamar a FCM.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
NOTIFICATIONS_QUEUE=notifications.events

# --- gateway ---
EVENTS_EXCHANGE=parklink.events
CORS_ORIGINS=*
