# El .env de root NO tiene claves de los microservicios: cada uno lee las suyas de
# su propio ./<servicio>/.env (fuera de git; `make env` los crea desde su .env.example).
#
# Acá solo va lo que no es de ningún microservicio:

# --- Túneles de Cloudflare (make online / compose.cloudflare.yaml) ---
CLOUDFLARE_TUNNEL_TOKEN_GATEWAY=
CLOUDFLARE_TUNNEL_TOKEN_EXPO=
