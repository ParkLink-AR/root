# Variables compartidas para levantar todo el ecosistema con `docker compose up`
# en la raíz. Cada servicio también tiene su propio .env.example con más detalle
# si preferís levantarlo suelto.

ENVIRONMENT=development

# --- auth-service / gateway (deben coincidir entre sí) ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Sin BREVO_API_KEY, auth-service no manda emails de verdad: en cambio, loguea
# el código de verificación de 6 dígitos ("[MAIL][DEV] Código de verificación
# para ...") -- mirá `docker compose logs -f auth-service` para copiarlo.
# SKIP_EMAIL_VERIFICATION=true saltea el requisito de confirmar el mail para
# loguear (útil para tests automatizados); en local, dejalo en false para
# probar el flujo real de código de 6 dígitos que ve mobile.
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# Twilio (SMS) - https://console.twilio.com. Mismo criterio que Brevo: sin
# credenciales, loguea el código en vez de mandar un SMS real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SKIP_EMAIL_VERIFICATION=false

# --- parking-service ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=parklink-app/1.0

# --- payment-service ---
# Credenciales de prueba (TEST) de Mercado Pago Developers. Sin esto el
# servicio arranca igual, pero crear una preferencia de pago real falla.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_SECRET_DE_MERCADO_PAGO
MP_FORCE_TEST_PAYER_EMAIL=
APP_BASE_URL=http://localhost:8004
WEBHOOK_BASE_URL=http://localhost:8004
FRONTEND_SUCCESS_URL=http://localhost:19006/payment/success
FRONTEND_FAILURE_URL=http://localhost:19006/payment/failure
FRONTEND_PENDING_URL=http://localhost:19006/payment/pending
DEFAULT_CURRENCY=ARS

# --- gateway ---
EVENTS_EXCHANGE=parklink.events
CORS_ORIGINS=*
