# Variables compartidas para levantar todo el ecosistema con `docker compose up`
# en la raíz. Cada servicio también tiene su propio .env.example con más detalle
# si preferís levantarlo suelto.

ENVIRONMENT=development

# --- auth-service / gateway (deben coincidir entre sí) ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- booking-service / payment-service (deben coincidir entre sí) ---
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# Sin BREVO_API_KEY, auth-service no manda emails de verdad: loguea el código
# de verificación de 6 dígitos (docker compose logs -f auth-service).
BREVO_API_KEY=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
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina


# Twilio (SMS). Cuenta paga con Trust Hub compliance profile aprobado.
TWILIO_ACCOUNT_SID=AC47a903e39d43c4acf97db63c1d3097bf
TWILIO_AUTH_TOKEN=8435ce516f77421ee3819f5c096967de
TWILIO_FROM_NUMBER=+16626231355

SKIP_EMAIL_VERIFICATION=true
SKIP_PHONE_VERIFICATION=false

R2_ACCOUNT_ID=f39a24e6a9a51c89d87f17877c333023
R2_ACCESS_KEY_ID=d53b32004e29bc17092059bc81cb19cd
R2_SECRET_ACCESS_KEY=82f4aaada4bbb54b70652884342640d8bb7f342660dadeceb82ddafbbb097735
R2_BUCKET_NAME=parklink-photos
R2_PUBLIC_URL=https://photos.parklink.com.ar

# --- parking-service ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=parklink-app/1.0

# --- payment-service ---
# Credenciales de prueba (TEST) de Mercado Pago Developers. Sin esto el
# servicio arranca igual, pero crear una preferencia de pago real falla.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-5935129209492371-083022-121fbc0f425d9c40be14724a4064ccdf-3339648528
MERCADOPAGO_WEBHOOK_SECRET=f39f99d8e7ca17d0cc1e6151d5b6d117334b37a9302b18abddac7f1285aef18b
MP_FORCE_TEST_PAYER_EMAIL=
APP_BASE_URL=http://localhost:8004
WEBHOOK_BASE_URL=http://localhost:8004
# El deep link de vuelta a la app (parklink://payment/pending) ya no se
# configura acá -- payment-service lo arma solo en su endpoint
# GET /payment-return, que es a donde apuntan los back_urls de Mercado Pago.
DEFAULT_CURRENCY=ARS

# --- gateway ---
EVENTS_EXCHANGE=parklink.events
CORS_ORIGINS=*
